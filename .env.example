# Puerto de la API
PORT=3000

# Base de datos
MONGO_URL=your_mongodb_connection_string

# JWT
JWT_SECRET=your_jwt_secret_key

# Frontend
FRONTEND_URL=https://mariobueno.info

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://api.mariobueno.info/usuarios/google/callback

# Spotify OAuth
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_CALLBACK_URL=https://api.mariobueno.info/usuarios/spotify/callback
SPOTIFY_LINK_CALLBACK_URL=https://api.mariobueno.info/usuarios/spotify/link/callback
